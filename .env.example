# KYT Memory Extension - Environment Variables
# Copy this to .env and fill in your actual values

# OpenAI API Key (for HyDE generation)
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace API Key (for Qwen3 embeddings via Nebius router)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Jina API Key (for cross-encoder reranking)
# Get free API key at: https://jina.ai/reranker/
JINA_API_KEY=your_jina_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# User ID (UUID format)
USER_ID=your_user_uuid_here
