# KYT Memory Extension - Environment Variables
# Copy this to .env and fill in your actual values

# OpenAI API Key (for HyDE generation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for intent classification Layer 2 — Haiku 4.5 LLM judge)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace API Key (for Qwen3 embeddings via Nebius router)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Jina API Key (for cross-encoder reranking)
# Get free API key at: https://jina.ai/reranker/
JINA_API_KEY=your_jina_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# User ID (UUID format)
USER_ID=your_user_uuid_here

# Stripe (for Founder's List checkout + webhook)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Landing Page URL (for Stripe checkout redirects)
LANDING_PAGE_URL=https://keepyourthoughts.app
