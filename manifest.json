{
  "manifest_version": 3,
  "name": "KYT Memory Extension - Day 3 RAG",
  "version": "0.3.0",
  "description": "RAG system: ChatGPT with long-term semantic memory via context injection",

  "permissions": [
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },

  "web_accessible_resources": [{
    "resources": ["inject.js", "inject-day3.js"],
    "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
  }],

  "minimum_chrome_version": "88"
}
