# KYT Validation Sprint - .gitignore
# Created: 2025-11-10
# Compliance: CLAUDE.md Rule 5 (Security First)

# ============================================
# CLAUDE CODE / MCP CONFIGURATION
# ============================================
.mcp.json
.claude/

# ============================================
# SECRETS AND CREDENTIALS
# ============================================
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
config/secrets.json
credentials.json
service-account*.json

# ============================================
# LOGS AND DEBUGGING
# ============================================
*.log
logs/
debug.log
error.log
validation/*.log
debug_*.txt
debug-sessions/

# ============================================
# CHROME EXTENSION ARTIFACTS
# ============================================
*.crx
*.pem
*.zip
web-ext-artifacts/

# ============================================
# CACHE AND TEMPORARY FILES
# ============================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.cache/
.pytest_cache/
.coverage
htmlcov/
*.tmp
*.temp

# ============================================
# IDE AND EDITOR FILES
# ============================================
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store

# ============================================
# OS GENERATED FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# NODE.JS (Future-proofing)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# ============================================
# BUILD AND DISTRIBUTION
# ============================================
build/dist/
build/output/
build/*.log
dist/
*.egg-info/
.webpack/

# ============================================
# DATABASE FILES (Day 2+)
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# USER DATA (Testing)
# ============================================
test_data/captured_*.json
validation/user_data/
.test-profile/
test-results/

# Test conversation exports
conversation_export*.json
tier_examples.json
tier_test_results.txt
*_test_results.txt

# ============================================
# BASELINE DATA (Validation Results)
# ============================================
baselines/
*.baseline.json

# ============================================
# SYNTHETIC DATA GENERATION
# ============================================
# Generated training datasets (never commit generated data)
data/
data/*.json
!data/.gitkeep

# Samples and checkpoints
data/samples/
data/checkpoints/

# Cost tracking (contains API usage data)
cost_tracking.json
scripts/cost_tracking.json

# Generation progress files
*_progress.json
*_checkpoint_*.json

# ============================================
# DIAGNOSTIC SCRIPTS WITH HARDCODED SECRETS
# ============================================
check_sources.js
*_diagnostic*.js
*_diagnostic*.mjs
verify_*.js
phase0_*.js
phase0_*.mjs
check_message_count.mjs

# Local/personal files
gravity_results.csv
test_output.txt

# ============================================
# DEVELOPMENT SCRIPTS AND DEBUG FILES
# ============================================
debug_import*.js
diagnostic_*.js
test_*.js
test_output*.txt
import_result.json
generate_*.js
