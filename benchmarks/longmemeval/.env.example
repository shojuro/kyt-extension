# LongMemEval harness config — copy to .env and fill in (DEDICATED benchmark project).
# These MUST point at the dedicated benchmark Supabase project, NOT production.

BENCH_SUPABASE_URL=https://YOUR_BENCH_PROJECT.supabase.co
BENCH_SERVICE_KEY=your_dedicated_project_service_role_key
BENCH_ANON_KEY=your_dedicated_project_anon_key

# Answer-generation model (the "chat assistant" that reads KYT's retrieved memories
# and produces a hypothesis answer). OpenAI by default for parity with LongMemEval.
ANSWER_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_key

# Judge (LongMemEval's official evaluate_qa.py) also uses OPENAI_API_KEY.
# Path to a local clone of https://github.com/xiaowu0162/longmemeval
LONGMEMEVAL_REPO=/path/to/longmemeval
