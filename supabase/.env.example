# Supabase Edge Functions Environment Variables
# ============================================
# SECURITY: This file contains ONLY placeholder values for documentation.
# NEVER commit actual secrets to version control.
# Copy this file to .env and fill in real values.
#
# Author: AI Engineer (Temporal Decay Feature - Worktree 2)
# Date: 2025-11-24

# OpenAI API Key (for memory classification)
# Get from: https://platform.openai.com/api-keys
# Used by: save_chat_turn Edge Function
# Model: gpt-4o-mini (cost: ~$0.15 per 1M input tokens)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Supabase Project URL
# Format: https://your-project-ref.supabase.co
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (SECRET - full database access)
# IMPORTANT: Use this ONLY in Edge Functions, NEVER in client code
# Get from: Supabase Dashboard → Settings → API → service_role key
# This key bypasses Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Anon Key (PUBLIC - safe to expose in client code)
# Get from: Supabase Dashboard → Settings → API → anon public key
# This key respects Row Level Security (RLS)
SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: Database Direct Connection String (for migrations)
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-ref.supabase.co:5432/postgres

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# 1. LOCAL DEVELOPMENT:
#    - Copy this file to supabase/.env
#    - Fill in real values
#    - Add supabase/.env to .gitignore
#    - Test locally: deno run --allow-all functions/save_chat_turn/index.ts
#
# 2. SUPABASE DEPLOYMENT:
#    - Navigate to: Supabase Dashboard → Edge Functions → Configuration
#    - Add environment variables through UI (not CLI)
#    - Variables are encrypted at rest
#    - Deploy: supabase functions deploy save_chat_turn
#
# 3. SECURITY CHECKLIST:
#    ✅ Never hard-code API keys in source code
#    ✅ Never commit .env files to git
#    ✅ Use service_role key ONLY in Edge Functions
#    ✅ Use anon key in client-side code
#    ✅ Enable RLS on all tables
#    ✅ Rotate keys regularly (every 90 days)
#
# =============================================================================
# COST MONITORING
# =============================================================================
#
# OpenAI API Costs (gpt-4o-mini):
# - Input: $0.15 per 1M tokens (~750K words)
# - Output: $0.60 per 1M tokens (~750K words)
# - Avg classification: ~500 input tokens + 50 output tokens = $0.00012
# - 1000 users, 10 memories each: $1.20
# - 10,000 users: $12.00
#
# Recommended: Set up budget alerts in OpenAI dashboard
# - Alert at: $10, $50, $100
# - Circuit breaker: Disable classification if budget exceeded
#
# =============================================================================

# =============================================================================
# STRIPE (Founder's List + Subscriptions)
# =============================================================================
#
# Stripe Secret Key (SERVER-SIDE ONLY)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret
# Get from: Stripe Dashboard → Developers → Webhooks → Signing secret
# Endpoint: https://your-project-ref.supabase.co/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Landing Page URL (for Stripe checkout success/cancel redirects)
LANDING_PAGE_URL=https://keepyourthoughts.app
